---
import TattooLogo from "./TattooLogo.astro"
---

<div class="AppHeader">
    <div class="AppHeader__flower">
        <img src="/img/profile.jpeg" alt="moi" />
        <img src="/img/potos.png" alt="moi" />
    </div>
    <div class="AppHeader__tattoo">
        <TattooLogo />
    </div>
</div>

<style scoped lang="scss">
    .AppHeader {
        display: flex;
        text-align: center;
        align-items: center;
        justify-content: center;

        &__tattoo {
            margin-left: 100px;
        }

        &__flower {
            position: relative;
            width: 150px;

            img:first-of-type {
                width: 100%;
                border-radius: 150px;
                box-shadow:
                    rgba(0, 0, 0, 0.07) 0px 1px 2px,
                    rgba(0, 0, 0, 0.07) 0px 2px 4px,
                    rgba(0, 0, 0, 0.07) 0px 4px 8px,
                    rgba(0, 0, 0, 0.07) 0px 8px 16px,
                    rgba(0, 0, 0, 0.07) 0px 16px 32px,
                    rgba(0, 0, 0, 0.07) 0px 32px 64px;
            }

            img:last-of-type {
                position: absolute;
                width: 200px;
                top: -50px;
                left: -50px;
            }
        }

        @include onlyMobile() {
            display: block;
            svg {
                width: 100%;
            }

            img {
                margin: auto;
            }
        }
    }
</style>
