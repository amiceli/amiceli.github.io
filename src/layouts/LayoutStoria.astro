---
interface Props {
    title: string;
    storia?: string;
}

const { title, storia } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Astro description" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <script
            async
            type="application/javascript"
            src="https://plausible.volpe.xyz/script.js"
            data-website-id="b8875c72-2935-418c-8464-215526912cf7"
            data-domains="miceli.click"></script>
    </head>
    <body>
        <header>
            <img src="/img/profile.jpeg" alt="moi" />
            <div>
                <a target="_blank" href="/storia">Storie</a>
                {storia && <span>/</span>}
                {storia && <span>{storia}</span>}
            </div>
        </header>
        <div class="App for--storia">
            <slot />
        </div>
    </body>
</html>

<style lang="scss" is:global>
    @import url("https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;500;600&display=swap");
    @import url(https://cdn.jsdelivr.net/npm/firacode@6.2.0/distr/fira_code.css);

    @font-face {
        font-family: "Kbanavoxlost";
        src: url("/font/Kbanavoxlost-gajq.ttf") format("woff");
    }

    html,
    body {
        font-family: "Exo 2", sans-serif;
        color: #d8dee9;
        background: #2e3440;

        @include onlyMobile() {
            width: 100%;
            overflow-x: hidden;
        }

        a {
            color: #5e81ac;
        }
    }

    .for--storia {
        font-size: 25px;

        h1 {
            font-size: 45px;
            color: #3be2a0;
        }
        h2 {
            font-size: 35px;
            color: #3be2a0;
        }
        h3 {
            font-size: 30px;
            color: #3be2a0;
        }
        h4 {
            font-size: 25px;
            color: #3be2a0;
        }
    }

    .astro-code:not(.without--padding) {
        padding: 24px;
    }
    code {
        background: darken(#2D353F, 5%);
        padding-left: 10px;
        padding-right: 10px;
        font-family: 'Fira Code', monospace;
    }
    pre code {
        background : inherit;
        padding-left: inherit;
        padding-right: inherit;
    }
</style>

<style lang="scss" scoped>
    .App {
        width: 80%;
        margin: auto;
        padding-top: 50px;
        padding-bottom: 100px;
    }
    header {
        height: 60px;
        display: grid;
        grid-template-columns: 40px 1fr;
        grid-gap: 20px;
        padding-left: 20px;
        padding-right: 20px;
        box-sizing: border-box;
        align-items: center;

        img {
            width: 40px;
            height: 40px;
            border-radius: 40px;
        }

        a {
            text-decoration: none;
        }

        img + div {
            font-size: 30px;
            display: flex;
            align-items: center;

            span {
                display: inline-block;
                vertical-align: middle;
                margin-right: 10px;
            }
        }
    }
</style>
